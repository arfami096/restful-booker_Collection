      "name": "Lesson2_dataDriven",
      "item": [
        {
          "name": "CreateBooking dataDriven",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rawTotalPrice = pm.iterationData.get(\"totalprice\");\nconst rawDepositPaid = pm.iterationData.get(\"depositpaid\");\n"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst response = pm.response.json();\n\npm.test(\"BookingID in response\", function () {\n    pm.expect(response).to.have.property(\"bookingid\");\n    pm.expect(response.bookingid).to.be.a(\"number\");\n});\n\nfunction toBoolean(value) {\n    if (typeof value === \"boolean\") return value;\n    var normalized = String(value).trim().toLowerCase();\n    if (normalized === \"true\") return true;\n    if (normalized === \"false\") return false;\n    throw new Error(\"Invalid boolean in data file: \" + value);\n}\n\nconst expectedFirstname = pm.iterationData.get(\"firstname\");\nconst expectedLastname = pm.iterationData.get(\"lastname\");\nconst expectedTotalprice = Number(pm.iterationData.get(\"totalprice\"));\nconst expectedDepositpaid = toBoolean(pm.iterationData.get(\"depositpaid\"));\n\npm.test(\"firstname has been saved correctly\", function () {\n    pm.expect(response.booking.firstname).to.eql(expectedFirstname);\n});\n\npm.test(\"lastname has been saved correctly\", function () {\n    pm.expect(response.booking.lastname).to.eql(expectedLastname);\n});\n\npm.test(\"totalprice has been saved correctly and as a number\", function () {\n    pm.expect(response.booking.totalprice).to.be.a(\"number\");\n    pm.expect(response.booking.totalprice).to.eql(expectedTotalprice);\n});\n\npm.test(\"depositpaid has been saved correctly and as a boolean value\", function () {\n    pm.expect(response.booking.depositpaid).to.be.a(\"boolean\");\n    pm.expect(response.booking.depositpaid).to.eql(expectedDepositpaid);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\" : \"{{firstname}}\",\n    \"lastname\" : \"{{lastname}}\",\n    \"totalprice\" : {{totalprice}},\n    \"depositpaid\" : {{depositpaid}},\n    \"bookingdates\" : {\n        \"checkin\" : \"{{checkin}}\",\n        \"checkout\" : \"{{checkout}}\"\n    },\n    \"additionalneeds\" : \"{{additionalneeds}}\"\n}",
